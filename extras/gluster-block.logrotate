# Rotate all the gluster-block logs
/var/log/gluster-block/*.log {
  sharedscripts
  weekly
  maxsize 10M
  minsize 100k

# 6 months of logs are good enough
  rotate 26

  missingok
  compress
  delaycompress
  notifempty

# gluster-block-apid reopens its log on SIGHUP
  postrotate
    systemctl kill -s HUP gluster-block-apid.service >/dev/null 2>&1 || true
  endscript
}
