# This file is part of gluster-block.
#
# This is a wrapper unit over target.service which ensures that
# tcmu-runner.service is running which intern has a check to see if
# glusterd.service is active
#
# It used to pull target.service in with '.include', which systemd no longer
# supports (ignored since v252: "bad unit file setting"), so the settings of
# target.service (target-restore package) are repeated here.
#

[Unit]
Description=Restore LIO kernel target configuration for gluster-block
Requires=sys-kernel-config.mount
After=sys-kernel-config.mount network.target local-fs.target
# target.service is called rtslib-fb-targetctl.service on Debian and Ubuntu
Conflicts=target.service rtslib-fb-targetctl.service
Requisite=glusterd.service
BindsTo=tcmu-runner.service
After=glusterd.service tcmu-runner.service targetclid.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/targetctl restore
# clear only while tcmu-runner is alive, '-' ignores the failure if it is not
ExecStop=-/bin/sh -c 'pgrep -x tcmu-runner >/dev/null && targetctl clear'
SyslogIdentifier=gluster-block-target
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
