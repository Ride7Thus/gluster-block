#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# /lib/systemd/system on Debian 12 and Ubuntu 22.04, /usr/lib/systemd/system later
UNITDIR := $(shell pkg-config --variable=systemdsystemunitdir systemd)

%:
	dh $@

# upgrade_activities.sh calls /usr/libexec/gluster-block/wait-for-bricks.sh
override_dh_auto_configure:
	dh_auto_configure -- --with-systemddir=$(UNITDIR) --libexecdir=/usr/libexec

# like the RPMs: install the units, do not enable or start them; an upgrade
# does not stop them either, debian/postinst restarts only gluster-blockd
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade

# tests/ need a gluster cluster
override_dh_auto_test:
