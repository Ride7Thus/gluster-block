
##-----------------------------------------------------------------------------
## All %%global definitions should be placed here and keep them sorted
##
%if ( 0%{?fedora} ) || ( 0%{?rhel} && 0%{?rhel} > 6 ) || ( 0%{?centos_version} && 0%{?centos_version} > 6)
%global _with_systemd true
%else
%global _with_initd true
%endif

%if ( 0%{?rhel} && 0%{?rhel} <= 7 ) || ( 0%{?centos_version} && 0%{?centos_version} <= 7 ) 
%global _disable_tirpc --enable-tirpc=no
%endif

# SELinux policy module in the gluster-block-selinux subpackage
%if ( 0%{?fedora} ) || ( 0%{?rhel} && 0%{?rhel} >= 8 )
%global _with_selinux true
%global selinuxtype targeted
%global modulename gluster_block
%endif

# gluster-block-apid, the HTTP API, in the gluster-block-api subpackage
%if ( 0%{?fedora} ) || ( 0%{?rhel} && 0%{?rhel} >= 8 )
%global _with_api true
%global _api_configure --enable-api
%else
%global _api_configure --disable-api
%endif


##-----------------------------------------------------------------------------
## All package definitions should be placed here
##
Summary:          Gluster block storage utility
Name:             @PACKAGE_NAME@
Version:          @PACKAGE_VERSION@
Release:          @PACKAGE_RELEASE@%{?dist}
License:          GPLv2 or LGPLv3+
URL:              https://github.com/gluster/gluster-block
Source0:          @PACKAGE_NAME@-@PACKAGE_VERSION@.tar.gz

BuildRequires:    gcc
BuildRequires:    make
BuildRequires:    pkgconfig(glusterfs-api)
BuildRequires:    pkgconfig(json-c)
BuildRequires:    pkgconfig(uuid)
%if ! 0%{?_disable_tirpc:1}
BuildRequires:    pkgconfig(libtirpc)
BuildRequires:    rpcgen
%endif
%if ( 0%{?_with_systemd:1} )
%{?systemd_requires}
%if ( 0%{?fedora} ) || ( 0%{?rhel} && 0%{?rhel} >= 9 )
BuildRequires:    systemd-rpm-macros
%else
BuildRequires:    systemd
%endif
%endif

Requires:         tcmu-runner >= 1.1.3
Requires:         targetcli >= 2.1.fb49
%if ( 0%{?fedora} ) || ( 0%{?rhel} && 0%{?rhel} >= 8 )
Requires:         python3-rtslib >= 2.1.fb69
# targetctl, used by gluster-block-target.service
Requires:         target-restore
%else
Requires:         python-rtslib >= 2.1.fb69
%endif
Requires:         rpcbind
%if ( 0%{?_with_selinux:1} )
BuildRequires:    selinux-policy-devel
BuildRequires:    bzip2
Requires:         (%{name}-selinux = %{version}-%{release} if selinux-policy-%{selinuxtype})
%endif

%description
gluster-block is a CLI utility, which aims at making gluster backed block
storage creation and maintenance as simple as possible.

%if ( 0%{?_with_api:1} )
%package api
Summary:          HTTP API of gluster-block (gluster-block-apid)
BuildRequires:    pkgconfig(libmicrohttpd)
# apid speaks the local RPC of gluster-blockd of the same build
Requires:         %{name} = %{version}-%{release}
%{?systemd_requires}

%description api
gluster-block-apid serves the HTTP API of gluster-block on a unix socket,
a bridge to the local gluster-blockd, for the Cockpit plugin and other
clients. API v1 is described in openapi.yaml.
%endif

%if ( 0%{?_with_selinux:1} )
%package selinux
Summary:          SELinux policy module for gluster-block
BuildArch:        noarch
Requires:         selinux-policy-%{selinuxtype}
Requires(post):   selinux-policy-%{selinuxtype}
%{?selinux_requires}

%description selinux
SELinux policy module for gluster-block: lets targetclid, which runs the
targetcli commands of gluster-blockd, write the configshell log in
/var/log/gluster-block.
%endif

%prep
%setup -q

%build
%configure %{?_disable_tirpc} %{_api_configure}
%make_build
%if ( 0%{?_with_selinux:1} )
%{__make} -C selinux -f %{_datadir}/selinux/devel/Makefile %{modulename}.pp
bzip2 -9 selinux/%{modulename}.pp
%endif

%install
%make_install
%if ( 0%{?_with_initd:1} )
mv %{buildroot}/%{_initddir}/gluster-blockd.initd %{buildroot}/%{_initddir}/gluster-blockd
%endif
%if ( 0%{?_with_selinux:1} )
install -D -p -m 0644 selinux/%{modulename}.pp.bz2 \
        %{buildroot}%{_datadir}/selinux/packages/%{selinuxtype}/%{modulename}.pp.bz2
%endif

%if ( 0%{?_with_selinux:1} )
%pre selinux
%selinux_relabel_pre -s %{selinuxtype}

%post selinux
%selinux_modules_install -s %{selinuxtype} %{_datadir}/selinux/packages/%{selinuxtype}/%{modulename}.pp.bz2

%postun selinux
if [ $1 -eq 0 ]; then
    %selinux_modules_uninstall -s %{selinuxtype} %{modulename}
fi

%posttrans selinux
%selinux_relabel_post -s %{selinuxtype}
%endif

%if ( 0%{?_with_systemd:1} )
# The %postun of the package being upgraded still restarts
# gluster-block-target (try-restart on EL8, a needs-restart marker on EL9)
# up to 0.5.27. Refuse that restart for the transaction: a runtime drop-in
# makes the unit refuse manual stops, %posttrans removes it and the marker.
%pre
if [ $1 -ge 2 ] && [ -d /run/systemd/system ]; then
    mkdir -p /run/systemd/system/gluster-block-target.service.d
    printf '[Unit]\nRefuseManualStop=yes\n' > \
        /run/systemd/system/gluster-block-target.service.d/50-upgrade.conf
    systemctl daemon-reload >/dev/null 2>&1 || :
fi

%posttrans
if [ -f /run/systemd/system/gluster-block-target.service.d/50-upgrade.conf ]; then
    systemctl set-property --runtime gluster-block-target.service \
        Markers=-needs-restart >/dev/null 2>&1 || :
    rm -f /run/systemd/system/gluster-block-target.service.d/50-upgrade.conf
    rmdir /run/systemd/system/gluster-block-target.service.d 2>/dev/null || :
    systemctl daemon-reload >/dev/null 2>&1 || :
fi

%post
%systemd_post gluster-block-target.service
%systemd_post gluster-blockd.service

%preun
%systemd_preun gluster-block-target.service
%systemd_preun gluster-blockd.service
find %{_sharedstatedir}/gluster-block/ -name 'gb_upgrade.status' -delete

%postun
# Restarting gluster-block-target on upgrade runs 'targetctl clear' and
# 'targetctl restore': every iSCSI session of the host drops and blocks with
# ha 1 stop serving. An upgrade does not change the LIO configuration, the
# new unit file takes effect with the daemon-reload of the macro; only the
# management daemon is restarted, it is not in the I/O path.
%systemd_postun gluster-block-target.service
%systemd_postun_with_restart gluster-blockd.service

%if ( 0%{?_with_api:1} )
%post api
%systemd_post gluster-block-apid.service

%preun api
%systemd_preun gluster-block-apid.service

%postun api
# restarted together with gluster-blockd of the same version
%systemd_postun_with_restart gluster-block-apid.service
%endif
%endif

%clean
rm -rf ${RPM_BUILD_ROOT}

%files
%doc README.md
%if ( 0%{?_with_initd:1} )
%doc COPYING-GPLV2 COPYING-LGPLV3
%else
%license COPYING-GPLV2 COPYING-LGPLV3
%endif
%{_sbindir}/gluster-block
%{_sbindir}/gluster-blockd
%{_mandir}/man8/gluster-block*.8*
%dir %{_localstatedir}/log/gluster-block
%if ( 0%{?_with_systemd:1} )
%{_unitdir}/gluster-blockd.service
%{_unitdir}/gluster-block-target.service
%else
%attr(0755,-,-) %{_initddir}/gluster-blockd
%endif
%config(noreplace) %{_sysconfdir}/sysconfig/gluster-blockd
%config(noreplace) %{_sysconfdir}/logrotate.d/gluster-block
%dir %attr(0755,-,-) %{_libexecdir}/gluster-block
     %attr(0755,-,-) %{_libexecdir}/gluster-block/wait-for-bricks.sh
     %attr(0755,-,-) %{_libexecdir}/gluster-block/upgrade_activities.sh
%dir %attr(0755,-,-) %{_sharedstatedir}/gluster-block
     %attr(0644,-,-) %{_sharedstatedir}/gluster-block/gluster-block-caps.info

%if ( 0%{?_with_api:1} )
%files api
%doc docs/api/openapi.yaml
%{_sbindir}/gluster-block-apid
%{_unitdir}/gluster-block-apid.service
%config(noreplace) %{_sysconfdir}/sysconfig/gluster-block-apid
%endif

%if ( 0%{?_with_selinux:1} )
%files selinux
%{_datadir}/selinux/packages/%{selinuxtype}/%{modulename}.pp.bz2
%ghost %verify(not md5 size mode mtime) %{_sharedstatedir}/selinux/%{selinuxtype}/active/modules/200/%{modulename}
%endif

%changelog
* Wed Nov 25 2026 Ride7Thus - 0.5.33
- Add hosts command: host state, rebalance and maintenance of a volume
- Add modify prio-path to move the active/optimized path of a block
- Wait for the I/O on the LUNs to stop before a host goes into maintenance
- Do not restart gluster-block-target on upgrade

* Tue Nov 24 2026 Ride7Thus - 0.5.27
- Accept --help, --version and --usage as the command
- Document block volumes on dispersed gluster volumes

* Tue Nov 24 2026 Ride7Thus - 0.5.25
- Detect systemd without a fixed unit path, explain a missing rpc/rpc.h
- Build on Debian and Ubuntu, .deb packages

* Mon Nov 23 2026 Ride7Thus - 0.5.21
- Show step, progress and remaining time of operations in status
- Add gluster-block-selinux subpackage with a policy module for targetclid

* Mon Nov 23 2026 Ride7Thus - 0.5.19
- Fix gluster-block-target.service on EL9, drop the unsupported .include
- Require target-restore for targetctl

* Mon Nov 23 2026 Ride7Thus - 0.5.18
- Create and resize finish in background, new status command
- Share operation results between nodes, confirm thin blocks on
  dispersed volumes, fix fallocate fallbacks and allocation mode on resize
- Build on EL8/EL9 (CentOS Stream, Rocky Linux, AlmaLinux): fix libtirpc
  BuildRequires, require python3-rtslib, add %%{?dist} to Release
- Add BuildRequires for gcc, make and libuuid, drop unused help2man

